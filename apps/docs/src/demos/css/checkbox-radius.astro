---
import { Checkmark } from "@winnie-ui/icons/react/solid";
---

<div class="flex items-start gap-4">
  <label data-component="checkbox" data-selected="true" data-radius="none">
    <button data-slot="indicator">
      <Checkmark data-slot="icon" />
    </button>
  </label>
  <label data-component="checkbox" data-selected="true" data-radius="sm">
    <button data-slot="indicator">
      <Checkmark data-slot="icon" />
    </button>
  </label>
  <label data-component="checkbox" data-selected="true" data-radius="md">
    <button data-slot="indicator">
      <Checkmark data-slot="icon" />
    </button>
  </label>
  <label data-component="checkbox" data-selected="true" data-radius="lg">
    <button data-slot="indicator">
      <Checkmark data-slot="icon" />
    </button>
  </label>
  <label data-component="checkbox" data-selected="true" data-radius="round">
    <button data-slot="indicator">
      <Checkmark data-slot="icon" />
    </button>
  </label>
</div>
