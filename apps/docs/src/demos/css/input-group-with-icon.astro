---
import { MagnifyingGlass } from "@winnie-ui/icons/react/line";
import { ChevronGrabberVertical } from "@winnie-ui/icons/react/solid";
---

<div class="flex flex-col gap-4">
  <div data-component="input-group">
    <MagnifyingGlass data-slot="icon" />
    <input
      data-component="input"
      data-slot="input"
      placeholder="Search dishes..."
    />
  </div>
  <div data-component="input-group">
    <input data-component="input" data-slot="input" placeholder="Select dish" />
    <ChevronGrabberVertical data-slot="icon" />
  </div>
</div>
