<div data-component="dialog" class="shadow-none" data-size="sm">
  <header data-component="dialog-header">
    <ol data-component="breadcrumbs">
      <li data-component="breadcrumb">
        <span data-slot="label">Home</span>
        <span data-slot="separator">/</span>
      </li>
      <li data-component="breadcrumb">
        <span data-slot="label">Dishes</span>
        <span data-slot="separator">/</span>
      </li>
      <li data-component="breadcrumb" data-current="true">
        <span data-slot="label">New Dish</span>
      </li>
    </ol>
  </header>
  <div data-component="dialog-content" class="flex flex-col gap-6">
    <div data-component="field">
      <label data-slot="label">Name</label>
      <div data-component="input-group" data-slot="control">
        <input data-component="input" data-slot="input" />
      </div>
    </div>
    <div data-component="field">
      <label data-slot="label">Description</label>
      <textarea
        data-component="textarea"
        data-slot="control"
        class="min-h-[75px]"></textarea>
    </div>
  </div>
  <footer data-component="dialog-footer">
    <button
      data-component="button"
      data-slot="cancel"
      data-accent-color="grey"
      data-variant="4">Cancel</button
    >
    <button data-component="button" data-slot="action" data-variant="1"
      >Create Dish</button
    >
  </footer>
</div>
