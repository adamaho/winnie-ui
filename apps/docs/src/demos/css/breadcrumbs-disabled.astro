---
import { HomeDoor } from "@winnie-ui/icons/react/solid";
---

<ol data-component="breadcrumbs">
  <li data-component="breadcrumb">
    <HomeDoor data-slot="icon" />
    <span data-slot="label">Home</span>
    <span data-slot="separator">/</span>
  </li>
  <li data-component="breadcrumb" data-disabled="true">
    <span data-slot="label">Dishes</span>
    <span data-slot="separator">/</span>
  </li>
  <li data-component="breadcrumb">
    <span data-slot="label">Margherita Pizza</span>
  </li>
</ol>
