---
import type { MarkdownHeading } from "astro";

import { AlignmentLeft } from "@winnie-ui/icons/react/line";

type Props = {
  headings: MarkdownHeading[];
};

const { headings } = Astro.props;
---

{
  headings.length > 0 && (
    <nav class="toc">
      <div class="mb-5 flex items-center gap-3">
        <AlignmentLeft color="grey" size="3" />
        <h2
          data-component="heading"
          data-size="2"
          data-weight="normal"
          data-accent-color="grey"
        >
          On this page
        </h2>
      </div>
      <ul class="before:bg-grey-6 relative px-6 before:absolute before:top-0 before:left-0 before:h-full before:w-[1px] before:content-['']">
        {headings.map((heading) => {
          if (heading.depth > 3) {
            return null;
          }

          return (
            <li
              class="nowrap group flex h-[calc(34px*var(--wui-scale))] items-center data-[level=3]:pl-3"
              data-accent-color="red"
              data-level={heading.depth}
            >
              <a
                data-component="text"
                data-weight="medium"
                data-accent-color="grey"
                data-size="2"
                data-contrast="normal"
                class="group-hover:text-grey-12"
                href={`#${heading.slug}`}
              >
                {heading.text}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  )
}
