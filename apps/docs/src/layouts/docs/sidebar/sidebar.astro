---
import type { CollectionKey } from "astro:content";
import { Navigation } from "./components/navigation/navigation";
import type { NavigationItem } from "./components/navigation/types";
import Logo from "../logo.astro";
import { SearchDesktop } from "./components/search";
import { ThemePickerDialog } from "./components/theme-picker/theme-picker-dialog";

export type Props = {
  collection: CollectionKey;
  navigation: NavigationItem[];
  slug: string;
};

const { collection, navigation, slug } = Astro.props;
---

<nav
  class="wui-docs-sidebar pt-0 lg:pt-4"
  transition:animate="none"
  data-component="layout-sidebar"
  data-state="docked"
  id="docs-sidebar"
>
  <div class="wui-docs-sidebar-header hidden justify-between pr-4 lg:flex">
    <Logo collection={collection} />
    <ThemePickerDialog client:load />
  </div>
  <div class="hidden w-full pr-4 lg:block">
    <SearchDesktop
      client:only="react"
      transition:persist
      collection={collection}
    />
  </div>
  <Navigation client:load transition:persist items={navigation} slug={slug} />
</nav>

<style>
  .wui-docs-sidebar {
    flex-direction: column;
    display: flex;

    .wui-logo-container {
      display: flex;
      flex-direction: column;
      flex: 1;
      gap: var(--wui-space-2);
    }

    .wui-docs-sidebar-actions {
      align-items: center;
      display: flex;
      gap: var(--wui-space-2);

      .wui-docs-sidebar-search-action {
        display: block;

        @media (min-width: 1024px) {
          display: none;
        }
      }
    }
  }
</style>
