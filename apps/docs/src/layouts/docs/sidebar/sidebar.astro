---
import type { CollectionKey } from "astro:content";
import { Actions } from "./components/actions";
import { Navigation } from "./components/navigation/navigation";
import type { NavigationItem } from "./components/navigation/types";
import Logo from "../logo.astro";
import { Search } from "./components/search";

export type Props = {
  collection: CollectionKey;
  navigation: NavigationItem[];
  slug: string;
};

const { collection, navigation, slug } = Astro.props;
---

<script>
  import { layoutStore } from "../store";

  layoutStore.store.subscribe(() => {
    document
      .getElementById("docs-sidebar")
      ?.setAttribute("data-state", layoutStore.store.state.sidebarState);
  });
</script>

<nav
  class="wui-docs-sidebar"
  transition:animate="none"
  data-component="layout-sidebar"
  id="docs-sidebar"
>
  <div class="wui-docs-sidebar-header">
    <Logo collection={collection} />
    <div class="wui-docs-sidebar-actions">
      <Actions client:only="react" transition:persist collection={collection} />
    </div>
  </div>
  <div class="mt-6 hidden w-full lg:block">
    <Search client:only="react" transition:persist collection={collection} />
  </div>
  <Navigation
    client:only="react"
    transition:persist
    items={navigation}
    slug={slug}
  />
</nav>

<style>
  .wui-docs-sidebar {
    flex-direction: column;
    display: flex;

    .wui-docs-sidebar-header {
      display: flex;

      .wui-logo-container {
        display: flex;
        flex-direction: column;
        flex: 1;
        gap: var(--wui-space-2);
      }

      .wui-docs-sidebar-actions {
        align-items: center;
        display: flex;
        gap: var(--wui-space-2);

        .wui-docs-sidebar-search-action {
          display: block;

          @media (min-width: 1024px) {
            display: none;
          }
        }
      }
    }

    .wui-navigation {
      display: none;
      user-select: none;

      @media (min-width: 1024px) {
        display: block;
      }
    }
  }
</style>
