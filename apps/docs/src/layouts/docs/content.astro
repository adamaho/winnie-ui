---
import type { MarkdownHeading } from "astro";

import TableOfContents from "./toc/toc.astro";

import type { CollectionKey } from "astro:content";

import { type DocsSchema } from "~/content.config";
import { DocumentationLinkButton } from "./documentation-link-button";
import { BarsThree } from "@winnie-ui/icons/react/solid";
import type { NavigationItem } from "./sidebar/components/navigation/types";

type Props = {
  title: string;
  description: string;
  documentation?: DocsSchema["documentation"];
  headings: MarkdownHeading[];
  collection: CollectionKey;
  navigation: NavigationItem[];
  slug: string;
};

const {
  title,
  description,
  documentation,
  headings,
  navigation,
  collection,
  slug,
} = Astro.props;

let sectionTitle = "Unknown Section";
let pageTitle = "Unknown Title";

for (const section of navigation) {
  if (section.items == null) {
    continue;
  }
  for (const page of section.items) {
    if (page.link === `/${collection}/docs/${slug}`) {
      sectionTitle = section.label;
      pageTitle = page.label;
      break;
    }
  }
}
---

<script>
  const sidebarToggle = document.querySelector(
    "#docs-menu-toggle",
  ) as HTMLInputElement;

  sidebarToggle?.addEventListener("change", (e) => {
    const sidebar = document.querySelector("#docs-sidebar");
    if ((e.currentTarget as HTMLInputElement)?.checked) {
      sidebar?.setAttribute("data-state", "open");
    } else {
      sidebar?.setAttribute("data-state", "closed");
    }
  });
</script>

<main data-component="layout-content">
  <div data-component="page">
    <header data-component="page-header" class="relative lg:hidden">
      <input type="checkbox" id="docs-menu-toggle" class="absolute" />
      <label
        data-component="button"
        data-variant="4"
        data-accent-color="grey"
        for="docs-menu-toggle"
        aria-label="Toggle Navigation Menu"
        class="absolute left-[var(--wui-space-4)] flex items-center justify-center"
      >
        <BarsThree data-slot="icon" />
      </label>
      <ol data-component="breadcrumbs" data-slot="breadcrumbs">
        <li data-component="breadcrumb">
          <span data-slot="label">{sectionTitle}</span>
          <span data-slot="separator">/</span>
        </li>
        <li data-component="breadcrumb">
          <span data-slot="label">{pageTitle}</span>
          <span data-slot="separator">/</span>
        </li>
      </ol>
    </header>
    <div
      class="relative flex flex-row items-start px-6 py-[calc(var(--wui-space-9)+var(--wui-space-5))] pb-7 lg:py-8"
      data-component="layout-content"
    >
      <article class="mx-auto w-full max-w-[70ch]">
        <div class="mb-9">
          <h1 data-component="heading" data-size="8">{title}</h1>
          <p
            data-component="text"
            data-size="4"
            data-contrast="normal"
            data-accent-color="grey"
            class="mt-2"
          >
            {description}
          </p>
          {
            documentation && (
              <div class="mt-5 flex items-center gap-3">
                {documentation?.map((doc) => {
                  return <DocumentationLinkButton {...doc} client:load />;
                })}
              </div>
            )
          }
        </div>
        <div class="wui-markdown-content">
          <slot />
        </div>
      </article>
      <aside
        class="not-has-[a] sticky top-[var(--wui-space-7)] hidden w-full max-w-[calc(250px*var(--wui-scale))] 2xl:block"
      >
        <TableOfContents headings={headings} />
      </aside>
    </div>
  </div>
</main>

<style>
  @layer markdown {
    .wui-markdown-content {
      --wui-markdown-content-font-size: calc(15px * var(--wui-scale));

      a:not(:where(.not-content *), .heading-anchor) {
        color: var(--wui-color-accent-11);
        border-radius: min(var(--wui-border-radius-1), 4px);
        font-size: var(--wui-markdown-content-font-size);
        font-weight: var(--wui-font-weight-medium);

        &:hover {
          color: var(--wui-color-accent-12);
        }

        &:focus-visible {
          outline: var(--wui-border-width-2) solid var(--wui-color-accent-9);
          outline-offset: var(--wui-space-1);
        }
      }

      p:not(:where(.not-content *)) {
        color: var(--wui-color-grey-12);
        font-size: var(--wui-markdown-content-font-size);
        font-weight: var(--wui-font-weight-normal);
        line-height: var(--wui-line-height-3);
        margin: var(--wui-space-6) auto;
      }

      h2 + p:not(:where(.not-content *)) {
        margin-bottom: var(--wui-space-7);
        margin-top: var(--wui-space-5);
      }

      h3 + p:not(:where(.not-content *)) {
        margin-bottom: var(--wui-space-7);
        margin-top: var(--wui-space-5);
      }

      code:not(:where(.not-content *)) {
        background: var(--wui-color-accent-3);
        border: var(--wui-border-width-1) solid var(--wui-color-accent-5);
        border-radius: min(var(--wui-border-radius-2), 6px);
        color: var(--wui-color-accent-12);
        font-family: var(--wui-font-family-mono);
        font-size: var(--wui-font-size-2);
        line-height: 1;
        margin: var(--wui-space-6) auto;
        padding-inline: var(--wui-space-1);
        padding-bottom: var(--wui-space-1);
      }

      ul:not(.not-content) {
        list-style-type: disc;
        margin: var(--wui-space-6) 0;
        padding-left: var(--wui-space-8);
      }

      .wui-navigation__disclosure-content {
        ul {
          list-style: none;
          margin: 0;
          padding: 0;
        }
      }
    }
  }
</style>
