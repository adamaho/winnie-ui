---
import type { CollectionEntry } from "astro:content";

import type { CollectionKey } from "astro:content";
import type { MarkdownHeading } from "astro";
import BaseHead from "~/layouts/base/head.astro";
import BaseLayout from "../base/layout.astro";
import Header from "./header.astro";
import Content from "./content.astro";
import Sidebar, { type Props as SidebarProps } from "./sidebar.astro";

type Props = CollectionEntry<"css">["data"] & {
  collection: CollectionKey;
  headings: MarkdownHeading[];
  navigation: SidebarProps["navigation"];
};

const { collection, title, description, slug, headings, navigation } =
  Astro.props;
---

<BaseLayout>
  <BaseHead slot="head" title={title} description={description} />
  <Header collection={collection} />
  <Sidebar collection={collection} slug={slug} navigation={navigation} />
  <Content
    title={title}
    description={description}
    headings={headings}
    collection={collection}
    slug={slug}
    navigation={navigation}
    transition:animate="none"
  >
    <slot />
  </Content>
</BaseLayout>
