---
import type { CollectionKey } from "astro:content";

export type Props = {
  collection: CollectionKey;
};

const { collection } = Astro.props;

const COLLECTION_TITLE_MAP = {
  css: "CSS",
  react: "React",
} satisfies Record<CollectionKey, string>;
---

<div class="flex items-center gap-4">
  <a
    data-component="text"
    data-accent-color="grey"
    data-size="3"
    data-weight="medium"
    data-contrast="high"
    href="/css">Winnie</a
  >
  <span class="bg-grey-8 width-[1px] h-[var(--wui-space-5)] rotate-[20deg]"
  ></span>
  <span
    data-component="text"
    data-accent-color="grey"
    data-contrast="normal"
    data-size="3">{COLLECTION_TITLE_MAP[collection]}</span
  >
</div>
