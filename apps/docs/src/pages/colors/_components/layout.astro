---
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/800.css";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const title = "Winnie Colors";
const description =
  "Beautifully crafted color system for building applications.";
---

<html>
  <head>
    <!-- Global Metadata -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon-orange.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <!-- <meta property="og:image" content={new URL(image, Astro.url)} /> -->

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <!-- <meta property="twitter:image" content={new URL(image, Astro.url)} /> -->
  </head>
  <body
    data-accent-color="lime"
    data-radius="md"
    data-scale="100%"
    data-theme="dark"
  >
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  body {
    --page-header-height: calc(56px * var(--wui-scale));
    --page-inline-padding: var(--wui-space-4);
    --page-accent-height: calc(18px * var(--wui-scale));

    background: var(--w-c-accent-1);

    @media (min-width: 768px) {
      --page-accent-height: calc(32px * var(--wui-scale));
    }
  }
</style>
