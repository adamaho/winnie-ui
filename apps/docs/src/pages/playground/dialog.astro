---
import { CrossLarge } from "@winnie-ui/icons/react/line";
---

<div data-component="dialog" data-size="sm" data-radius="round">
  <header data-component="dialog-header">
    <ol data-component="breadcrumbs">
      <li data-component="breadcrumb">
        <span data-slot="label">Home</span>
        <span data-slot="separator">/</span>
      </li>
      <li data-component="breadcrumb">
        <span data-slot="label">Dishes</span>
        <span data-slot="separator">/</span>
      </li>
      <li data-component="breadcrumb" data-current="true">
        <span data-slot="label">New Dish</span>
      </li>
    </ol>
    <button
      data-component="button"
      data-size="sm"
      data-accent-color="grey"
      data-variant="4"
      data-slot="close"
    >
      <CrossLarge data-slot="icon" />
    </button>
  </header>
  <input data-slot="title" placeholder="Dish name" />
  <textarea
    data-slot="description"
    placeholder="Add description..."
    class="min-h-[75px]"></textarea>
  <footer data-component="dialog-footer">
    <button
      data-component="button"
      data-slot="cancel"
      data-radius="lg"
      data-variant="4">Cancel</button
    >
    <button
      data-component="button"
      data-slot="action"
      data-variant="1"
      data-radius="lg">Create Dish</button
    >
  </footer>
</div>

<style>
  [data-component="dialog"] {
    background: var(--w-c-layer-3);
    border: 1px solid var(--w-c-layer-2-border-color);
    border-radius: 40px;
    box-shadow:
      inset 0 0 0 8px var(--w-c-layer-2),
      inset 0 0 0 9px var(--w-c-layer-3-border-color),
      0px 0px 1px 2px oklch(from var(--w-c-layer-1) l c h / 20%),
      0px 0px 2px 2px oklch(from var(--w-c-layer-1) l c h / 20%),
      0px 0px 4px 4px oklch(from var(--w-c-layer-1) l c h / 15%),
      0px 0px 16px 8px oklch(from var(--w-c-layer-1) l c h / 15%),
      0px 0px 24px 16px oklch(from var(--w-c-layer-1) l c h / 10%);
    padding: 12px;
  }

  [data-component="button"] {
    &[data-variant="1"] {
      background: var(--w-c-accent-9);
      color: var(--w-c-accent-contrast);
    }

    &[data-variant="4"] {
      background: var(--w-c-accent-grey-4);
      color: var(--w-c-accent-grey-13);
    }
  }
</style>
