---
import { Image } from "astro:assets";
import mountains from "~/assets/mountains.webp";
---

<!-- https://x.com/JayDwivedi_/status/1921186691684917563/photo/2 -->
<div data-component="twitter-card">
  <Image
    src={mountains}
    data-slot="image"
    alt="mountains in the dark"
    width={720}
  />
  <div class="twitter-card-content-container">
    <div class="twitter-card-content">
      <h2
        data-component="heading"
        data-slot="title"
        data-size="3"
        data-weight="extrabold"
      >
        card 1
      </h2>
      <p
        class="mt-3"
        data-component="text"
        data-slot="description"
        data-size="3"
        data-weight="semibold"
      >
        Set up your <span class="highlight">event in minutes</span>. Name it,
        date it, <span class="highlight">done</span>.
      </p>
    </div>
  </div>
</div>

<style>
  @media (prefers-color-scheme: light) {
    [data-component="twitter-card"] {
      --w-c-tcard-shadow:
        0px 0px 1px 2px oklch(from black l c h / 1%),
        0px 2px 2px oklch(from black l c h / 2%),
        0px 4px 4px oklch(from black l c h / 2%),
        0px 8px 8px oklch(from black l c h / 2%),
        0px 16px 16px oklch(from black l c h / 2%);
    }
  }

  @media (prefers-color-scheme: dark) {
    [data-component="twitter-card"] {
      --w-c-tcard-shadow:
        0px 0px 1px 2px oklch(from black l c h / 10%),
        0px 2px 2px oklch(from black l c h / 10%),
        0px 4px 4px oklch(from black l c h / 15%),
        0px 8px 8px oklch(from black l c h / 10%),
        0px 16px 16px oklch(from black l c h / 5%);
    }
  }

  [data-component="twitter-card"] {
    background: var(--w-c-layer-2);
    border: 1px solid oklch(from var(--w-c-layer-2-border) l c h / 90%);
    border-radius: 50px;
    box-shadow: var(--w-c-tcard-shadow);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 8px;
    position: relative;
    height: 300px;
    width: 330px;

    [data-slot="image"] {
      border-radius: 48px;
      padding: 8px;
      height: 100%;
      left: 0;
      /* mask-image: linear-gradient(var(--w-c-layer-1) 10%, transparent 90%); */
      position: absolute;
      top: 0;
      width: 100%;
      z-index: 0;
    }

    .twitter-card-content-container {
      position: relative;
      padding: 8px;

      .twitter-card-content {
        background: var(--w-c-layer-3);
        border-radius: 32px;
        padding-inline: 24px;
        padding-block: 24px;

        [data-slot="title"] {
          color: var(--w-c-forground-2);
          text-transform: uppercase;
          letter-spacing: -0.025em;
        }

        [data-slot="description"] {
          color: var(--w-c-forground-2);
          line-height: 1.5;
          letter-spacing: -0.025em;

          .highlight {
            color: var(--w-c-forground-1);
          }
        }
      }
    }
  }
</style>
