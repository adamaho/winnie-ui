---
import BaseLayout from "../layouts/base/layout.astro";
import BaseHead from "../layouts/base/base-head.astro";
---

<BaseLayout>
  <BaseHead slot="head" />
  <div
    class="root flex h-dvh flex-col items-center justify-center gap-2 p-9"
    data-theme="dark"
    style={{ background: "black" }}
  >
    <div class="flex gap-3" data-accent-color="red">
      {
        new Array(6).fill(0).map((_, i) => {
          return (
            <div
              class="color rounded-2 h-[60px] w-[60px] shrink-0"
              data-color={i + 1}
            />
          );
        })
      }
    </div>
