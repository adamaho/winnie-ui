---
import BaseLayout from "../layouts/base/layout.astro";
import BaseHead from "../layouts/base/head.astro";

import { Controls } from "./_controls";
---

<BaseLayout>
  <BaseHead slot="head" title="Playground" description="Place to play around" />
  <Controls client:only="react" />
  <div
    data-component="layout"
    id="playground"
    data-accent-color="mustard"
    class="grey"
  >
    <nav data-component="layout-sidebar"></nav>
    <main data-component="layout-content">
      <div data-component="page">
        <header data-component="page-header"></header>
        <div data-component="page-content" class="flex flex-col gap-5">
          <div data-component="page-block" class="p-5">
            <div class="rounded-3 h-full p-5">
              <div class="rounded-3 h-full p-5">
                <div class="rounded-3 h-full p-5">
                  <div class="rounded-3 h-full p-5"></div>
                </div>
              </div>
            </div>
          </div>
          <div data-component="page-block" class="p-3">
            <div class="rounded-3 h-full p-5">
              <h2 data-component="heading" data-size="5" data-weight="medium">
                Create Issue
              </h2>
              <p data-component="text" class="mb-4" data-size="3">
                Issues are a thing that lets you track things.
              </p>
              <footer class="flex justify-end gap-4">
                <button data-component="button" data-size="md" class="grey">
                  <span data-slot="label">Cancel</span>
                </button>
                <button data-component="button" data-size="md">
                  <span data-slot="label">Create Issue</span>
                </button>
              </footer>
            </div>
          </div>
          <div
            data-component="page-block"
            class="black flex flex-col gap-1 p-3"
          >
            <section class="flex items-center gap-1">
              {
                new Array(13).fill(0).map((_, i) => {
                  return (
                    <span class="chip h-[50px] w-[50px]" data-shade={i + 1} />
                  );
                })
              }
            </section>
            <section class="flex items-center gap-1">
              {
                new Array(13).fill(0).map((_, i) => {
                  return (
                    <span
                      class="chip grey h-[50px] w-[50px]"
                      data-shade={i + 1}
                    />
                  );
                })
              }
            </section>
