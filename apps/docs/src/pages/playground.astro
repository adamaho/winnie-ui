---
import BaseLayout from "../layouts/base/layout.astro";
import BaseHead from "../layouts/base/head.astro";
---

<BaseLayout>
  <BaseHead slot="head" title="Playground" description="Place to play around" />
  <div data-component="layout" data-accent-color="apricot" class="grey">
    <nav data-component="layout-sidebar"></nav>
    <main data-component="layout-content">
      <div data-component="page">
        <header data-component="page-header"></header>
        <div data-component="page-content" class="flex flex-col gap-5">
          <div data-component="page-block" class="p-5">
            <div class="rounded-3 h-full p-5">
              <div class="rounded-3 h-full p-5">
                <div class="rounded-3 h-full p-5">
                  <div class="rounded-3 h-full p-5"></div>
                </div>
              </div>
            </div>
          </div>
          <div data-component="page-block" class="p-3">
            <div class="rounded-3 h-full p-5">
              <h2 data-component="heading" data-size="5" data-weight="medium">
                Create SPiDR
              </h2>
              <p data-component="text" class="mb-4" data-size="3">
                Issues are a thing that lets you track things.
              </p>
              <footer class="flex justify-end gap-4">
                <button data-component="button" data-size="md" class="grey">
                  <span data-slot="label">Cancel</span>
                </button>
                <button data-component="button" data-size="md">
                  <span data-slot="label">Create Issue</span>
                </button>
              </footer>
            </div>
          </div>
          <div data-component="page-block" class="black flex gap-1 p-3">
            <!-- <span class="chip h-[50px] w-[50px]" data-accent-color="grass"
            ></span>
            <span class="chip h-[50px] w-[50px]" data-accent-color="basil"
            ></span> -->
            <span class="chip h-[50px] w-[50px]" data-accent-color="apricot"
            ></span>
            <span class="chip h-[50px] w-[50px]" data-accent-color="tuscon"
            ></span>
            <!-- <span class="chip h-[50px] w-[50px]" data-accent-color="peppermint"
            ></span>
            <span class="chip h-[50px] w-[50px]" data-accent-color="pine"
            ></span> -->
            <!-- <span class="chip h-[50px] w-[50px]" data-accent-color="teal">
            </span>
            <span class="chip h-[50px] w-[50px]" data-accent-color="sea"></span> -->
          </div>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .root {
    background: black;
  }

  .chip {
    background: var(--w-c-accent-9);
  }

  .grey {
    &[data-component="layout"] {
      background: var(--w-c-accent-g1);

      [data-component="page"] {
        background: var(--w-c-accent-g2);
        border: 1px solid var(--w-c-accent-g3);

        [data-component="page-header"] {
          border-bottom: 1px solid var(--w-c-accent-g3);
        }

        [data-component="page-content"] {
          padding: var(--wui-space-5);
        }

        [data-component="page-block"] {
          &.black {
            background: black;
          }

          background: var(--w-c-accent-g3);
          border: 1px solid var(--w-c-accent-g4);
          border-radius: var(--wui-border-radius-5);

          div {
            background: var(--w-c-accent-g4);
            border: 1px solid var(--w-c-accent-g5);

            div {
              background: var(--w-c-accent-g5);
              border: 1px solid var(--w-c-accent-g6);

              div {
                background: var(--w-c-accent-g6);
                border: 1px solid var(--w-c-accent-g7);

                div {
                  background: var(--w-c-accent-g7);
                  border: 1px solid var(--w-c-accent-g8);
                }
              }
            }

            [data-component="heading"] {
              color: var(--w-c-accent-g13);
              letter-spacing: var(--wui-letter-spacing-9);
            }

            [data-component="text"] {
              color: var(--w-c-accent-g12);
            }

            button {
              background: var(--w-c-accent-9);
              color: var(--w-c-accent-contrast);

              &:hover {
                background: var(--w-c-accent-10);
              }

              &:active {
                background: var(--w-c-accent-11);
              }

              &.grey {
                background: var(--w-c-accent-g9);
                color: var(--w-c-accent-gcontrast);

                &:hover {
                  background: var(--w-c-accent-g10);
                }

                &:active {
                  background: var(--w-c-accent-g11);
                }
              }
            }
          }
        }
      }
    }
  }

  .color {
    &[data-component="layout"] {
      background: var(--w-c-accent-1);

      [data-component="page"] {
        background: var(--w-c-accent-2);
        border: 1px solid var(--w-c-accent-3);

        [data-component="page-header"] {
          border-bottom: 1px solid var(--w-c-accent-3);
        }

        [data-component="page-content"] {
          padding: var(--wui-space-5);
        }

        [data-component="page-block"] {
          &.black {
            background: black;
          }

          background: var(--w-c-accent-3);
          border: 1px solid var(--w-c-accent-4);
          border-radius: var(--wui-border-radius-5);

          div {
            background: var(--w-c-accent-4);
            border: 1px solid var(--w-c-accent-5);

            div {
              background: var(--w-c-accent-5);
              border: 1px solid var(--w-c-accent-6);

              div {
                background: var(--w-c-accent-6);
                border: 1px solid var(--w-c-accent-7);

                div {
                  background: var(--w-c-accent-7);
                  border: 1px solid var(--w-c-accent-8);
                }
              }
            }

            [data-component="heading"] {
              color: var(--w-c-accent-13);
              letter-spacing: var(--wui-letter-spacing-9);
            }

            [data-component="text"] {
              color: var(--w-c-accent-12);
            }

            button {
              background: var(--w-c-accent-9);
              color: var(--w-c-accent-contrast);

              &:hover {
                background: var(--w-c-accent-10);
              }

              &:active {
                background: var(--w-c-accent-11);
              }

              &.grey {
                background: var(--w-c-accent-g9);
                color: var(--w-c-accent-gcontrast);

                &:hover {
                  background: var(--w-c-accent-g10);
                }

                &:active {
                  background: var(--w-c-accent-g11);
                }
              }
            }
          }
        }
      }
    }
  }
</style>
