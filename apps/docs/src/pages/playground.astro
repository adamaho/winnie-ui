<style>
  @property --wui-c {
    syntax: "*";
    inherits: false;
    initial-value: calc(c * 0.1);
  }

  @property --wui-dark-mix {
    syntax: "*";
    inherits: false;
    initial-value: calc(l * 100%);
  }

  .binary {
    background: oklch(from red l var(--wui-c) h);
  }

  .color {
    &[data-color="1"] {
      background: var(--wui-color-accent-1);
      border: 1px solid var(--wui-color-accent-2);
    }

    &[data-color="2"] {
      background: var(--wui-color-accent-2);
      border: 1px solid var(--wui-color-accent-3);
    }

    &[data-color="3"] {
      background: var(--wui-color-accent-3);
      border: 1px solid var(--wui-color-accent-4);
    }

    &[data-color="4"] {
      background: var(--wui-color-accent-4);
      border: 1px solid var(--wui-color-accent-5);
    }

    &[data-color="5"] {
      background: var(--wui-color-accent-5);
      border: 1px solid var(--wui-color-accent-6);
    }

    &[data-color="6"] {
      background: var(--wui-color-accent-6);
    }

    &[data-color="7"] {
      background: var(--wui-color-accent-7);
      border: 1px solid var(--wui-color-accent-8);
      color: var(--wui-color-accent-contrast);
    }

    &[data-color="8"] {
      background: var(--wui-color-accent-8);
      border: 1px solid var(--wui-color-accent-9);
      color: var(--wui-color-accent-contrast);
    }

    &[data-color="9"] {
      background: var(--wui-color-accent-9);
      color: var(--wui-color-accent-contrast);
    }

    &[data-color="10"] {
      background: var(--wui-color-accent-10);
    }

    &[data-color="11"] {
      background: var(--wui-color-accent-11);
    }

    &[data-color="12"] {
      background: var(--wui-color-accent-12);
    }
  }

  .grey {
    &[data-color="1"] {
      background: var(--wui-color-accent-grey-1);
      border: 1px solid var(--wui-color-accent-grey-2);
    }

    &[data-color="2"] {
      background: var(--wui-color-accent-grey-2);
      border: 1px solid var(--wui-color-accent-grey-3);
    }

    &[data-color="3"] {
      background: var(--wui-color-accent-grey-3);
      border: 1px solid var(--wui-color-accent-grey-4);
    }

    &[data-color="4"] {
      background: var(--wui-color-accent-grey-4);
      border: 1px solid var(--wui-color-accent-grey-5);
    }

    &[data-color="5"] {
      background: var(--wui-color-accent-grey-5);
      border: 1px solid var(--wui-color-accent-grey-6);
    }

    &[data-color="6"] {
      background: var(--wui-color-accent-grey-6);
    }

    &[data-color="7"] {
      background: var(--wui-color-accent-grey-7);
      border: 1px solid var(--wui-color-accent-grey-8);
      color: var(--wui-color-accent-grey-contrast);
    }

    &[data-color="8"] {
      background: var(--wui-color-accent-grey-8);
      border: 1px solid var(--wui-color-accent-grey-9);
      color: var(--wui-color-accent-grey-contrast);
    }

    &[data-color="9"] {
      background: var(--wui-color-accent-grey-9);
