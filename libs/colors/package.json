{
  "name": "@winnie-ui/colors",
  "version": "0.0.1",
  "description": "Colors",
  "author": "Adam Aho",
  "type": "module",
  "exports": {
    ".": "./src/index.css",
    "./red": "./src/red.css",
    "./orange": "./src/orange.css",
    "./yellow": "./src/yellow.css",
    "./lime": "./src/lime.css",
    "./green": "./src/green.css",
    "./cyan": "./src/cyan.css",
    "./blue": "./src/blue.css",
    "./purple": "./src/purple.css",
    "./pink": "./src/pink.css",
    "./brown": "./src/brown.css"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.min.css",
      "./red": "./src/red.min.css"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "rimraf dist && bun ./scripts/build.ts",
    "clean": "rimraf node_modules .dist"
  },
  "devDependencies": {
    "@winnie-ui/lightning": "workspace:*",
    "@winnie-ui/tsconfig": "workspace:*",
    "rimraf": "6.0.1"
  }
}
