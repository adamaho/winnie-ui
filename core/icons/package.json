{
  "name": "@winnie-ui/icons",
  "version": "0.0.1",
  "description": "Internal set of used for apps and documentation",
  "author": "Adam Aho",
  "private": "true",
  "type": "module",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "import": {
        "default": "./src/index.ts",
        "types": "./src/index.ts"
      }
    },
    "./line": {
      "import": {
        "default": "./src/line/index.ts",
        "types": "./src/line/index.ts"
      }
    },
    "./solid": {
      "import": {
        "default": "./src/solid/index.ts",
        "types": "./src/solid/index.ts"
      }
    },
    "./css": "./src/index.css"
  },
  "scripts": {
    "clean": "rimraf node_modules",
    "format:check": "biome format ./src --no-errors-on-unmatched",
    "format:write": "biome format ./src --write --no-errors-on-unmatched"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "clsx": "2.1.1"
  },
  "devDependencies": {
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@winnie-ui/ts-config": "workspace:*",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "rimraf": "6.0.1",
    "typescript": "5.7.2"
  }
}
