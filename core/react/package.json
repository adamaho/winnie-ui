{
  "name": "@winnie-ui/react",
  "version": "0.0.26",
  "description": "React component implementation using Winnie CSS",
  "author": "Adam Aho",
  "type": "module",
  "files": ["dist", "package.json"],
  "exports": {
    "./button": {
      "import": {
        "default": "./src/components/button.tsx",
        "types": "./src/components/button.tsx"
      }
    },
    "./button.css": "./src/styles/button.css",
    "./heading": {
      "import": {
        "default": "./src/components/typography/heading.tsx",
        "types": "./src/components/typography/heading.tsx"
      }
    },
    "./layout": {
      "import": {
        "default": "./src/components/layout.tsx",
        "types": "./src/components/layout.tsx"
      }
    },
    "./layout.css": "./src/styles/layout.css",
    "./link": {
      "import": {
        "default": "./src/components/typography/link.tsx",
        "types": "./src/components/typography/link.tsx"
      }
    },
    "./link.css": "./src/styles/link.css",
    "./link-button": {
      "import": {
        "default": "./src/components/link-button.tsx",
        "types": "./src/components/link-button.tsx"
      }
    },
    "./listbox.css": "./src/styles/listbox.css",
    "./menu": {
      "import": {
        "default": "./src/components/menu.tsx",
        "types": "./src/components/menu.tsx"
      }
    },
    "./navigation": {
      "import": {
        "default": "./src/components/navigation.tsx",
        "types": "./src/components/navigation.tsx"
      }
    },
    "./navigation.css": "./src/styles/navigation.css",
    "./text": {
      "import": {
        "default": "./src/components/typography/text.tsx",
        "types": "./src/components/typography/text.tsx"
      }
    },
    "./page.css": "./src/styles/page.css",
    "./popover.css": "./src/styles/popover.css",
    "./separator.css": "./src/styles/separator.css",
    "./css": "./src/styles/index.css",
    "./typography.css": "./src/styles/typography.css"
  },
  "scripts": {
    "clean": "rimraf node_modules",
    "format:check": "biome format ./src --no-errors-on-unmatched",
    "format:write": "biome format ./src --write --no-errors-on-unmatched"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-alpha.5",
    "@react-aria/utils": "3.26.0",
    "@winnie-ui/icons": "workspace:*",
    "clsx": "2.1.1",
    "react-aria": "3.36.0",
    "react-aria-components": "1.5.0"
  },
  "devDependencies": {
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@winnie-ui/ts-config": "workspace:*",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "rimraf": "6.0.1",
    "typescript": "5.7.2"
  }
}
