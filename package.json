{
  "name": "winnie-ui",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo run build --cache-dir=.turbo",
    "changeset": "changeset",
    "changeset:publish": "changeset publish",
    "clean": "turbo run clean && rimraf node_modules",
    "format:check": "prettier --check \"**/*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc,astro,css,yml,yaml}\"",
    "format:write": "prettier --write \"**/*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc,astro,css,yml,yaml}\"",
    "tsc": "turbo run tsc",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.5.1",
    "@changesets/cli": "2.29.5",
    "@trivago/prettier-plugin-sort-imports": "5.2.2",
    "husky": "9.1.7",
    "lint-staged": "16.1.5",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.6.14",
    "rimraf": "6.0.1",
    "turbo": "2.5.6"
  },
  "packageManager": "pnpm@10.12.4"
}
